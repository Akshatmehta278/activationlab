# Django
DJANGO_SECRET_KEY=replace-me-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,backend
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Full Docker database
DB_ENGINE=mysql
MYSQL_DATABASE=activationlab
MYSQL_USER=activationlab
MYSQL_PASSWORD=activationlab
MYSQL_ROOT_PASSWORD=activationlab-root
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Async customer imports
USE_CELERY=1
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Demo seed on Docker startup
SEED_DEMO=1

# Optional AI copilot. Leave blank and the app uses safe local rules.
OPENAI_API_KEY=
OPENAI_MODEL=
